{
  "name": "oriel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_REGISTRY", "class_name": "DeviceRegistryObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceRegistryObject"] },
  ],
  // ponytail: 運用値は測定と検証専用環境の実動作から決める設計(ROADMAP.md)
  // だが、初回の実動作確認そのものにこの値が要る。妥当な初期値を置き、
  // 実際の使用感を見て調整する前提とする。
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23liLe7gluNc45KCEI",
    "GITHUB_APP_ID": "4632357",
    "GITHUB_APP_JWT_LIFETIME_SECONDS": "540",
    "RELAY_ORIGIN": "https://oriel-relay.mikan-919.workers.dev",
    // 配布物versionの正本は root package.json とする(ROADMAP.md)。deployは
    // `--var RELAY_VERSION:<version>`で上書きし、ここは開発時の値に留める。
    "RELAY_VERSION": "0.0.0-dev",
    "DEVICE_CODE_EXPIRY_MS": "300000",
    "DEVICE_CANCELLATION_EXPIRY_MS": "300000",
    "OWNERSHIP_HEARTBEAT_INTERVAL_MS": "30000",
    "OWNERSHIP_HEARTBEAT_EXPIRY_MS": "90000",
    "OWNERSHIP_AUDIT_INTERVAL_MS": "60000",
    "TRANSCRIPT_SEARCH_TIMEOUT_MS": "5000",
    "LINEAR_WEBHOOK_MAX_SKEW_MS": "300000",
  },
  "env": {
    "staging": {
      "name": "oriel-relay-staging",
      "durable_objects": {
        "bindings": [
          { "name": "DEVICE_REGISTRY", "class_name": "DeviceRegistryObject" },
        ],
      },
    },
  },
}
