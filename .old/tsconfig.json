{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"],
  "exclude": ["apps/relay", "apps/web"]
}
