{
  "name": "@mikan-919/oriel",
  "version": "0.1.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikan-919/oriel.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "oriel": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/harness.js",
    "dist/migrations",
    "dist/web"
  ],
  "scripts": {
    "build": "bun build apps/serve/src/cli.ts --outfile dist/cli.js --target bun --banner '#!/usr/bin/env bun' && bun build apps/harness/src/main.ts --outfile dist/harness.js --target bun --banner '#!/usr/bin/env bun' && bun run --cwd apps/web build && rm -rf dist/migrations && cp -r apps/serve/migrations dist/migrations",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun run build && bun test apps/serve apps/harness apps/web packages && bun run test:relay",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/relay && tsc --noEmit -p apps/web",
    "test:relay": "node node_modules/vitest/vitest.mjs run --root apps/relay"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "4.20251117.0",
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.0",
    "wrangler": "4.44.0"
  }
}
